# Copy to .env and fill in real values. Never commit a filled-in .env; it's
# already excluded by .gitignore (.env, .env.*, except this file).
# Render deployment and secrets handling: see DEPLOYMENT.md.

# --- start:api ---
PORT=3000
# Defaults to 127.0.0.1 (loopback only). The API has no authentication, so keep
# it on loopback unless it is given its own auth (DEPLOYMENT.md, "Read API").
HOST=127.0.0.1

# --- start:worker ---
PROVIDER_ID=provider
PROVIDER_HOST=provider.example
RAW_STORE_ROOT=/var/lib/web-scraper/raw
USER_AGENT=web-scraper (+ops@example.com)
ELIGIBILITY_PREDICATE=To == CurrentSeasonEndingYear
# Leave unset: the season is derived from when the school index was fetched. Set the ending year
# (2027 for 2026-27) only if the site's index lists a different season than that.
CURRENT_SEASON_ENDING_YEAR=
# JSON documents; see AUTHORIZATION_CONTRACT.md for the required shape.
AUTHORIZATION_JSON={}
DATA_CONTRACT_JSON={}
# Optional sample restriction of the crawl scope (REQUEST_POLICY.md, #78), as JSON.
CRAWL_SAMPLE=
# Leave unset for a real crawl: the fewest eligible schools a school index may yield (default 300).
MIN_ELIGIBLE_SCHOOLS=
# manifest for the #44 dry run (index and history pages only); unset for a full crawl.
CRAWL_STAGE=
# Optional parser-version overrides after a parser upgrade (PARSER_NORMALIZATION.md).
PARSER_VERSIONS=
# --- start:operator (the PIN-protected trigger; a secret, at least 8 characters) ---
OPERATOR_PIN=
# Proxies in front of the trigger, for the per-client PIN lockout (default 1 on Render; 0 if unproxied).
OPERATOR_TRUSTED_PROXY_HOPS=

# Reviewers allowed to record dispositions with npm run review; unset means nobody.
OPERATOR_IDS=

# --- PostgreSQL persistence ---
# start:api and start:worker use these only with PERSISTENCE=postgres
# (default: memory). Migrations must already be applied.
PERSISTENCE=memory
PGHOST=localhost
PGPORT=5432
PGDATABASE=web_scraper
PGUSER=web_scraper
PGPASSWORD=
# require for external hosts (e.g. Render's external URL); omit for internal ones.
PGSSLMODE=
# Server-side statement timeout in milliseconds (default 30000).
PG_STATEMENT_TIMEOUT_MS=

# --- smoke:migrations / test:postgres (disposable database only) ---
# Deliberately not set here: PG_SMOKE_CONFIRM and PG_TEST_CONFIRM. They are the
# operator's confirmation that the PG* values point at a throwaway database, so
# set them for a single command, for example:
#   PG_TEST_CONFIRM=disposable npm run test:postgres
# Even then the scripts refuse a non-local PGHOST and a database that already
# holds crawl data (OPERATIONS_RUNBOOK.md, "Test a migration on a disposable database").
