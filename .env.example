# Copy to .env and fill in real values. Never commit a filled-in .env; it's
# already excluded by .gitignore (.env, .env.*, except this file).

# --- start:api ---
PORT=3000

# --- start:worker ---
PROVIDER_ID=provider
PROVIDER_HOST=provider.example
RAW_STORE_ROOT=/var/lib/web-scraper/raw
USER_AGENT=web-scraper (+ops@example.com)
ELIGIBILITY_PREDICATE=To == 2026
# JSON documents; see AUTHORIZATION_CONTRACT.md for the required shape.
AUTHORIZATION_JSON={}
DATA_CONTRACT_JSON={}

# --- PostgreSQL persistence (read by the pg client's default libpq env vars) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=web_scraper
PGUSER=web_scraper
PGPASSWORD=

# --- smoke:migrations / test:postgres (disposable database only) ---
PG_SMOKE_CONFIRM=disposable
PG_TEST_CONFIRM=disposable
